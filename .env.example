# Порты дев-окружения. Один файл на фронт и бэк.
# Копия создаётся автоматически при `yarn dev`; правьте .env, не этот файл.

# API. Имя UVICORN_* не случайно — uvicorn читает его сам, флаг --port не нужен.
UVICORN_PORT=8000
# Vite dev-сервер. Сюда же смотрит прокси /api -> UVICORN_PORT.
WEB_PORT=5173

# Здесь живут ТОЛЬКО порты: файл подмешивается в окружение бэкенда,
# а переменные окружения перебивают backend/.env. Настройки приложения
# (БД, размер сессии, CORS_ORIGINS) держите в backend/.env.
