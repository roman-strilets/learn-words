# Путь к файлу SQLite (относительно каталога backend/)
DATABASE_URL=sqlite:///./data/app.db
# Сколько новых слов предлагать в начале сессии
NEW_WORDS_PER_SESSION=5
# Максимум карточек в одной сессии
SESSION_SIZE=20
# Дневной лимит новых слов
DAILY_NEW_LIMIT=20
# Origins для CORS (через запятую)
CORS_ORIGINS=http://localhost:5173
