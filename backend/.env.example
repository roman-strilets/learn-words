# Путь к файлу SQLite (относительно каталога backend/)
DATABASE_URL=sqlite:///./data/app.db
# Сколько новых слов даёт занятие «Учить слова»
NEW_WORDS_PER_SESSION=5
# Сколько слов даёт занятие «Повторить слова»
REVIEW_WORDS_PER_SESSION=5
# Дневной лимит новых слов
DAILY_NEW_LIMIT=20
# Фразы считают свои лимиты отдельно от слов
# NEW_PHRASES_PER_SESSION=5
# REVIEW_PHRASES_PER_SESSION=5
# DAILY_NEW_PHRASES_LIMIT=20
# Сколько слов даёт одно занятие «Учить группу» (без дневного лимита)
# GROUP_WORDS_PER_SESSION=5
# Origins для CORS (через запятую)
CORS_ORIGINS=http://localhost:5173
# Классификатор меток: действует, пока на вкладке «Настройки → Разметка» ничего не сохранено
CLASSIFIER_BASE_URL=http://localhost:11434
CLASSIFIER_API_KEY=ollama
CLASSIFIER_MODEL=nimble
# Сколько секунд ждать ответа модели на одну пачку слов
CLASSIFIER_TIMEOUT_SECONDS=120
